<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_cam</name>
  <version>1.0.0</version>
  <description>
    树莓派端 USB 摄像头采集节点：V4L2 取流 -> JPEG -> sensor_msgs/CompressedImage。
    QoS 固定为 BEST_EFFORT + KEEP_LAST(1)，从物理上杜绝实时视频流的队列积压。
  </description>
  <maintainer email="FFFantasy11@users.noreply.github.com">FFFantasy11</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
